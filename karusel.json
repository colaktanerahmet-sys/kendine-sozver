[
 {"id": 1, "tema": "gundogumu", "kapak": "Hayatını sessizce değiştiren 5 küçük sabah sözü",
  "maddeler": [["Telefondan önce su", "Güne ekranla değil, kendinle başla."],
               ["Yatağını topla", "Günün ilk zaferi 30 saniye sürer."],
               ["Bir şeyi yüksek sesle söyle", "\"Bugün kendime iyi bakacağım.\""],
               ["5 dakika ışık al", "Pencereyi aç, gökyüzüne bak."],
               ["Tek bir öncelik seç", "Her şeyi değil, bir şeyi bitir."]]},
 {"id": 2, "tema": "gunbatimi", "kapak": "Kendine yüklendiğin gün bunları hatırla",
  "maddeler": [["Yorgunluk tembellik değildir", "Bedenin dinlenmek istiyor, cezalandırma."],
               ["Herkesin kötü günü olur", "Bugün kötü geçtiyse sen kötü değilsin."],
               ["Yavaş ilerlemek de ilerlemektir", "Durmadığın sürece yoldasın."],
               ["Kendine bir arkadaş gibi konuş", "Ona söylemeyeceğin sözü kendine de söyleme."],
               ["Yarın yeni bir sayfa", "Bu gece sadece dinlen."]]},
 {"id": 3, "tema": "dag", "kapak": "Disiplini kolaylaştıran 5 gizli kural",
  "maddeler": [["2 dakika kuralı", "Başlamak, bitirmekten daha önemli."],
               ["Zinciri kırma", "Her gün azıcık, hiç yapmamaktan iyidir."],
               ["Ortamı hazırla", "Spor ayakkabın kapının önünde dursun."],
               ["Motivasyonu bekleme", "Önce harekete geç, istek arkadan gelir."],
               ["Kendini yakala", "Erteliyorsan sadece ilk adımı at."]]},
 {"id": 4, "tema": "deniz", "kapak": "Zihnini sakinleştiren 5 cümle",
  "maddeler": [["\"Bu da geçecek.\"", "Hiçbir duygu sonsuza dek kalmaz."],
               ["\"Şu an güvendeyim.\"", "Nefesini hisset, buradasın."],
               ["\"Her şeyi kontrol etmek zorunda değilim.\"", "Bırakmak da bir güçtür."],
               ["\"Yeterince iyiyim.\"", "Kanıtlaman gereken kimse yok."],
               ["\"Bir adım yeter.\"", "Bütün merdiveni görmen gerekmiyor."]]},
 {"id": 5, "tema": "orman", "kapak": "Kendine söz verdiğinde bu 5 hatayı yapma",
  "maddeler": [["Çok büyük başlamak", "Küçük söz, tutulan sözdür."],
               ["Herkese anlatmak", "Sessizce yap, sonuç konuşsun."],
               ["Tek hatada bırakmak", "Bir gün kaçırmak, vazgeçmek değildir."],
               ["Başkasıyla kıyaslamak", "Senin yarışın dünkü kendinle."],
               ["Ödülü unutmak", "Tuttuğun her sözü kutla."]]},
 {"id": 6, "tema": "yildiz", "kapak": "Uyumadan önce kendine sor",
  "maddeler": [["Bugün neye minnettarım?", "Küçük de olsa bir şey bul."],
               ["Neyi iyi yaptım?", "Kendini takdir etmeyi unutma."],
               ["Neyi bırakmam gerek?", "Bugünün yükünü yarına taşıma."],
               ["Kime teşekkür etmeliyim?", "Bir mesaj, birinin gününü değiştirir."],
               ["Yarın tek bir şey ne olsun?", "Net bir niyetle uyu."]]},
 {"id": 7, "tema": "sehir", "kapak": "Odaklanamıyorsan bunları dene",
  "maddeler": [["Bildirimleri kapat", "Her titreşim dikkatini çalar."],
               ["25 dakika, sonra 5 mola", "Beynin kısa koşuları sever."],
               ["Masanı sadeleştir", "Göz ne görürse zihin onu düşünür."],
               ["Önce en zor işi yap", "Sonrası hep yokuş aşağı."],
               ["Su iç, hareket et", "Yorgun beden dağınık zihin demek."]]},
 {"id": 8, "tema": "yagmur", "kapak": "Zor dönemden geçenlere 5 hatırlatma",
  "maddeler": [["Yardım istemek güçtür", "Yalnız taşımak zorunda değilsin."],
               ["Hislerin geçerli", "Üzülmene izin ver."],
               ["Küçük şeyleri say", "Bugün kalktın, bu bile bir adım."],
               ["Bu bölüm senin hikâyenin tamamı değil", "Sayfa döner."],
               ["Kendine şefkat göster", "Şu an en çok buna ihtiyacın var."]]},
 {"id": 9, "tema": "yol", "kapak": "1 yıl sonra kendine teşekkür ettirecek 5 alışkanlık",
  "maddeler": [["Her gün 10 sayfa oku", "Yılda 15 kitap eder."],
               ["Her gün 20 dakika yürü", "Kafa da beden de açılır."],
               ["Para biriktir, az da olsa", "Gelecekteki sen rahat nefes alır."],
               ["Uyku saatini sabitle", "Her şey iyi uykuyla başlar."],
               ["Haftada bir kendinle buluş", "Planla, düşün, düzelt."]]},
 {"id": 10, "tema": "gokyuzu", "kapak": "Kendini değersiz hissettiğinde oku",
  "maddeler": [["Değerin performansına bağlı değil", "Var olman yeterli."],
               ["Herkes seni sevmek zorunda değil", "Seni sevenlere odaklan."],
               ["Geçmişteki hataların sen değilsin", "Onlardan öğrenen sensin."],
               ["Sosyal medya vitrin", "Başkalarının arka planını görmüyorsun."],
               ["Kendine iyi davran", "Bunu hak ediyorsun."]]},
 {"id": 11, "tema": "gundogumu", "kapak": "Ertelemeyi bitiren 5 basit taktik",
  "maddeler": [["İşi en küçük parçaya böl", "\"Dosyayı aç\" bile bir görevdir."],
               ["Bir zaman söyle", "\"Sonra\" değil, \"saat 3'te\"."],
               ["Kusursuzluğu bırak", "Bitmiş, mükemmelden iyidir."],
               ["Zamanlayıcı kur", "Sadece 10 dakika, sonra bırakabilirsin."],
               ["Neden yaptığını yaz", "Amacını gördükçe kolaylaşır."]]},
 {"id": 12, "tema": "gunbatimi", "kapak": "Bu akşam kendine 5 söz ver",
  "maddeler": [["Ekranı erken kapatacağım", "Uykudan önce 30 dakika ekransız."],
               ["Bugünü affedeceğim", "Eksikleriyle birlikte."],
               ["Yarını hazırlayacağım", "Kıyafet, çanta, tek görev."],
               ["Derin nefes alacağım", "4 say al, 6 say ver."],
               ["Kendime teşekkür edeceğim", "Bugün de elimden geleni yaptım."]]},
 {"id": 13, "tema": "dag", "kapak": "Hedefine ulaşanların ortak 5 özelliği",
  "maddeler": [["Sabırlılar", "Sonuç gecikir, emek boşa gitmez."],
               ["Sistem kurarlar", "Hedef yön verir, sistem götürür."],
               ["Başarısızlığı veri sayarlar", "Her düşüş bir ders."],
               ["Çevrelerini seçerler", "Seni büyütenlerle zaman geçir."],
               ["Her gün biraz yaparlar", "Süreklilik yeteneği yener."]]},
 {"id": 14, "tema": "deniz", "kapak": "Kaygı geldiğinde uygula",
  "maddeler": [["5-4-3-2-1 tekniği", "5 şey gör, 4 dokun, 3 duy, 2 kokla, 1 tat."],
               ["Nefesini uzat", "Verişin, alışından uzun olsun."],
               ["Düşünceni yaz", "Kâğıda dökülen yük hafifler."],
               ["\"Şu an\" sorusunu sor", "Şu an gerçekten tehlikede miyim?"],
               ["Hareket et", "Kısa bir yürüyüş zihni toparlar."]]},
 {"id": 15, "tema": "orman", "kapak": "Kendinle barışmak için 5 adım",
  "maddeler": [["İç sesini fark et", "Ne söylediğini dinle."],
               ["Eleştiriyi yumuşat", "\"Beceremem\" yerine \"öğreniyorum\"."],
               ["Bedenine teşekkür et", "Seni her gün taşıyor."],
               ["Sınır koy", "\"Hayır\" demek kendini korumaktır."],
               ["Küçük başarıları yaz", "Her akşam bir tane."]]},
 {"id": 16, "tema": "yildiz", "kapak": "İyi bir uyku için 5 söz",
  "maddeler": [["Aynı saatte yatacağım", "Beden ritmi sever."],
               ["Kafeini öğleden sonra bırakacağım", "Uykun teşekkür eder."],
               ["Odamı karartacağım", "Karanlık, derin uyku demek."],
               ["Yatakta telefona bakmayacağım", "Yatak dinlenmek içindir."],
               ["Zihnimi boşaltacağım", "Aklındakileri bir kâğıda yaz."]]},
 {"id": 17, "tema": "sehir", "kapak": "Pazartesi sendromuna 5 çözüm",
  "maddeler": [["Pazar akşamı planla", "Pazartesiyi belirsizlik yormasın."],
               ["Hafif bir başlangıç yap", "İlk saat kolay işlerle."],
               ["Kendine küçük bir ödül koy", "Sevdiğin kahve, sevdiğin şarkı."],
               ["Haftanın tek hedefini seç", "Net hedef, net zihin."],
               ["Erken yat", "Pazartesi, pazar gecesi başlar."]]},
 {"id": 18, "tema": "yagmur", "kapak": "Yalnız hissettiğinde bunları bil",
  "maddeler": [["Bu his geçici", "Kalıcı gibi görünse de değişir."],
               ["Birine yaz", "Basit bir \"nasılsın\" bile köprü kurar."],
               ["Kendine eşlik et", "Bir yürüyüş, bir kitap, bir çay."],
               ["Sen düşündüğünden daha değerlisin", "Birileri seni önemsiyor."],
               ["Yeni bağlar kur", "Bir kurs, bir grup, bir topluluk."]]},
 {"id": 19, "tema": "yol", "kapak": "Hayatını sadeleştirecek 5 söz",
  "maddeler": [["Her şeye yetişmek zorunda değilim", "Seçmek, özgürleşmektir."],
               ["Gereksiz eşyadan kurtulacağım", "Az eşya, az dağınıklık."],
               ["Beni yoran ilişkilere sınır koyacağım", "Enerjin değerli."],
               ["Takvimimde boşluk bırakacağım", "Nefes alacak alan yarat."],
               ["Bugünü yaşayacağım", "Her an bir sonrakine hazırlık değil."]]},
 {"id": 20, "tema": "gokyuzu", "kapak": "Özgüvenini büyüten 5 küçük hareket",
  "maddeler": [["Dik dur", "Beden duruşu zihne sinyal gönderir."],
               ["Göz teması kur", "Varlığını hisset ve hissettir."],
               ["Verdiğin sözü tut", "Özgüven, kendine güvenmektir."],
               ["Yeni bir şey öğren", "Her beceri seni büyütür."],
               ["Övgüyü kabul et", "\"Teşekkür ederim\" yeterli."]]},
 {"id": 21, "tema": "gundogumu", "kapak": "Enerjin düşükse bunları dene",
  "maddeler": [["Bir bardak su", "Yorgunluğun çoğu susuzluktur."],
               ["10 dakika güneş", "Işık enerjini uyandırır."],
               ["Kısa bir esneme", "Bedenini uyandır."],
               ["Sevdiğin bir şarkı", "Ruh hâli 3 dakikada değişir."],
               ["Bir meyve ye", "Şekerli atıştırmalık yerine."]]},
 {"id": 22, "tema": "gunbatimi", "kapak": "Geçmişi bırakmak için 5 hatırlatma",
  "maddeler": [["Değiştiremeyeceğini kabul et", "Kabul, teslim olmak değildir."],
               ["O günkü seni affet", "O zaman bildiğin buydu."],
               ["Dersini al, yükünü bırak", "Öğrendiğini taşı, acıyı değil."],
               ["Bugüne odaklan", "Hayatın şu an yaşanıyor."],
               ["Yeni anılar biriktir", "Hikâyen hâlâ yazılıyor."]]},
 {"id": 23, "tema": "dag", "kapak": "Vazgeçmek üzereysen bunu oku",
  "maddeler": [["Neden başladığını hatırla", "O his hâlâ orada."],
               ["Ne kadar yol aldığına bak", "Başladığın yerde değilsin."],
               ["Dinlen ama bırakma", "Mola, vazgeçmek değildir."],
               ["Planı değiştir, hedefi değil", "Başka bir yol mutlaka var."],
               ["En karanlık an şafaktan öncedir", "Biraz daha dayan."]]},
 {"id": 24, "tema": "deniz", "kapak": "Mutluluğu küçük şeylerde bulmak için",
  "maddeler": [["Sabah kahveni yavaş iç", "Tadına gerçekten var."],
               ["Gökyüzüne bak", "Her gün başka bir tablo."],
               ["Birini güldür", "Mutluluk paylaştıkça çoğalır."],
               ["Sevdiğin şarkıyı aç", "Ve sesini biraz yükselt."],
               ["Bugün iyi giden 3 şeyi yaz", "Beyin aradığını bulur."]]}
]
